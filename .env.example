# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only used by the daily reminder job. Keep secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The app's public address, used in email links
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Shown in the header and emails
NEXT_PUBLIC_APP_NAME=Sign Off

# Email (optional until you want digests and reminders) - resend.com
RESEND_API_KEY=
EMAIL_FROM=Sign Off <approvals@yourdomain.com>

# Protects the reminder job. Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=
# Remind approvers when a post has waited this many days
REMINDER_DAYS=3
